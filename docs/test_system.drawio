        <mxCell id="cfa7DgKJdH_yal8gfmx6-33" parent="cfa7DgKJdH_yal8gfmx6-32" style="rounded=0;whiteSpace=wrap;html=1;align=center;" value="&lt;div align=&quot;center&quot;&gt;number&lt;br&gt;text&lt;br&gt;bool&lt;br&gt;llm_text&lt;br&gt;bbox&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;literal&lt;/div&gt;" vertex="1">
